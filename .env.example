# ======================================
# UNIVERSAL MUSIC HUB X - Environment Config
# ======================================

# ======================================
# GENERAL
# ======================================
NODE_ENV=development
APP_NAME="Universal Music Hub X"
APP_VERSION=0.1.0
LOG_LEVEL=debug

# ======================================
# FRONTEND
# ======================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_SENTRY_DSN=

# ======================================
# BACKEND API
# ======================================
PORT=3001
API_HOST=0.0.0.0
API_VERSION=v1
API_PREFIX=/api

# ======================================
# DATABASE
# ======================================
DATABASE_URL="postgresql://music_hub:password@localhost:5432/music_hub"
DATABASE_REPLICA_URL="postgresql://music_hub:password@localhost:5432/music_hub_replica"

# ======================================
# REDIS
# ======================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ======================================
# ELASTICSEARCH
# ======================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ======================================
# KAFKA
# ======================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=music-hub-api
KAFKA_GROUP_ID=music-hub-group

# ======================================
# AUTHENTICATION
# ======================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRATION=30d

# ======================================
# OAUTH2 - SPOTIFY
# ======================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback/spotify

# ======================================
# OAUTH2 - GOOGLE
# ======================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# ======================================
# OAUTH2 - APPLE
# ======================================
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=http://localhost:3000/auth/callback/apple

# ======================================
# OAUTH2 - DISCORD
# ======================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback/discord

# ======================================
# MUSIC PROVIDERS
# ======================================
SPOTIFY_API_CLIENT_ID=
SPOTIFY_API_CLIENT_SECRET=
APPLE_MUSIC_DEVELOPER_TOKEN=
YOUTUBE_API_KEY=
SOUNDCLOUD_CLIENT_ID=
DEEZER_ACCESS_TOKEN=
TIDAL_CLIENT_ID=
AMAZON_MUSIC_API_KEY=

# ======================================
# AI/ML SERVICES
# ======================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
STABILITY_AI_API_KEY=

# ======================================
# AWS
# ======================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=music-hub-storage

# ======================================
# EMAIL
# ======================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=noreply@music-hub.example.com

# ======================================
# SECURITY
# ======================================
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12

# ======================================
# MONITORING
# ======================================
SENTRY_DSN=
DATADOG_API_KEY=
NEW_RELIC_LICENSE_KEY=

# ======================================
# ADMIN
# ======================================
ADMIN_EMAIL=admin@music-hub.example.com
ADMIN_PASSWORD=changeme
ADMIN_PORT=3002
